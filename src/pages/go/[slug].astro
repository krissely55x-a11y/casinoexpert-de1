---
import { OFFER_PARAMETER_NAMES, OFFER_URL } from '../../config/offer';

export function getStaticPaths() {
  const offers = [
    'casinobuck',
    'crownplay',
    'gioo',
    'goodman',
    'gslot',
    'haz',
    'hejgo',
    'hitnspin',
    'horus',
    'kryptosino',
    'levelup',
    'luckyelf',
    'myempire',
    'rant',
    'rebellion',
    'rockwin',
    'scream',
    'skycrown',
    'vegaz',
    'vinyl',
  ];

  return offers.map((slug) => ({
    params: { slug },
  }));
}

const offer = Astro.params.slug ?? 'unknown';
const fallbackUrl = new URL(OFFER_URL);
fallbackUrl.searchParams.set(OFFER_PARAMETER_NAMES.offer, offer);
const target = fallbackUrl.href;
---

<!DOCTYPE html>
<html lang="de-DE">
  <head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex, nofollow" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <title>Weiterleitung zum Angebot</title>
  </head>
  <body>
    <p>Du wirst zum Angebot weitergeleitet.</p>
    <p><a href={target} rel="nofollow sponsored noreferrer">Jetzt weiter</a></p>
    <script is:inline define:vars={{ offerUrl: OFFER_URL, parameterNames: OFFER_PARAMETER_NAMES, offer }}>
      const destination = new URL(offerUrl);
      const currentUrl = new URL(window.location.href);

      destination.searchParams.set(parameterNames.offer, offer);
      [parameterNames.source, parameterNames.placement].forEach((name) => {
        const value = currentUrl.searchParams.get(name);
        if (value) destination.searchParams.set(name, value);
      });

      window.location.replace(destination.href);
    </script>
  </body>
</html>
